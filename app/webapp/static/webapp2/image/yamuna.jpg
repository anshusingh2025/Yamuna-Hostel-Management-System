pan class=3D"x78zum5 x1cy8zhl" title=3D"=E2=80=AA&lt;!DOCTYPE html&gt;
&lt;html lang=3D&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=3D&quot;UTF-8&quot;&gt;
&lt;meta name=3D&quot;viewport&quot; content=3D&quot;width=3Ddevice-width, =
initial-scale=3D1.0&quot;&gt;
&lt;title&gt;Contact Us&lt;/title&gt;

&lt;style&gt;

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Hero Section
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.hero{
    width:100%;
    height:60vh;
    background:
    linear-gradient(grey,black),
    url(&quot;../Image/leaf.jpg&quot;);
    background-size:cover;
    background-position:center;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    color:white;
    padding:20px;
}

.Contact{
    max-width:700px;
}

.Contact h1{
    font-size:55px;
    margin-bottom:15px;
    color:orange;
}

.Contact h2{
    font-size:28px;
    margin-bottom:20px;
}

.Contact p{
    font-size:18px;
    line-height:30px;
    color:#f2f2f2;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Contact Section
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.contact-section{
    width:100%;
    padding:80px 8%;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:50px;
    background:#f7f8fc;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Left Side
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.contact-info{
    width:40%;
}

.contact-info h2{
    font-size:40px;
    color:#222;
    margin-bottom:20px;
}

.contact-info&gt;p{
    color:#666;
    line-height:28px;
    margin-bottom:35px;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Info Box
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.info-box{
    background:white;
    padding:20px;
    border-radius:15px;
    margin-bottom:20px;
    box-shadow:0 5px 15px rgba(0,0,0,.08);
    transition:.4s;
}

.info-box:hover{
    transform:translateY(-8px);
    box-shadow:0 10px 25px rgba(0,0,0,.15);
}

.info-box h4{
    color:orange;
    font-size:22px;
    margin-bottom:8px;
}

.info-box p{
    color:#555;
    font-size:17px;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Right Side
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.contact-form{
    width:60%;
    background:white;
    padding:40px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,.08);
    transition:.4s;
}

.contact-form:hover{
    transform:translateY(-5px);
}

.contact-form h2{
    font-size:35px;
    margin-bottom:30px;
    color:#222;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Form
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

form{
    display:flex;
    flex-direction:column;
}

input,
textarea{
    width:100%;
    padding:15px;
    margin-bottom:20px;
    border:1px solid #ccc;
    border-radius:10px;
    font-size:16px;
    outline:none;
    transition:.3s;
}

input:focus,
textarea:focus{
    border-color:orange;
    box-shadow:0 0 10px rgba(255,165,0,.4);
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Button
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

button{
    width:220px;
    padding:15px;
    border:none;
    border-radius:10px;
    background:orange;
    color:white;
    font-size:17px;
    cursor:pointer;
    transition:.4s;
}

button:hover{
    background:#222;
    transform:translateY(-4px);
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Responsive
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

@media(max-width:992px){

.contact-section{
    flex-direction:column;
}

.contact-info,
.contact-form{
    width:100%;
}

.Contact h1{
    font-size:42px;
}

.Contact h2{
    font-size:24px;
}

}

@media(max-width:600px){

.hero{
    height:50vh;
}

.Contact h1{
    font-size:35px;
}

.Contact h2{
    font-size:20px;
}

.Contact p{
    font-size:16px;
}

.contact-info h2,
.contact-form h2{
    font-size:30px;
}

button{
    width:100%;
}

}

&lt;/style&gt;

&lt;/head&gt;
&lt;body&gt;

&lt;!-- Hero Section --&gt;

&lt;section class=3D&quot;hero&quot;&gt;

&lt;div class=3D&quot;Contact&quot;&gt;

&lt;h1&gt;Contact Us&lt;/h1&gt;

&lt;h2&gt;We're Here to Help You Learn&lt;/h2&gt;

&lt;p&gt;
Have questions about courses, tutors, or enrollment?
Our team is always ready to help you with the best support.
Feel free to contact us anytime.
&lt;/p&gt;

&lt;/div&gt;

&lt;/section&gt;


&lt;!-- Contact Section --&gt;

&lt;section class=3D&quot;contact-section&quot;&gt;

&lt;div class=3D&quot;contact-info&quot;&gt;

&lt;h2&gt;Get In Touch&lt;/h2&gt;

&lt;p&gt;
We'd love to hear from you! Contact us for course details,
technical support, tutor information, or any other query.
&lt;/p&gt;

&lt;div class=3D&quot;info-box&quot;&gt;
&lt;h4&gt;=F0=9F=93=A7 Email&lt;/h4&gt;
&lt;p&gt;support@learnnest.com&lt;/p&gt;
&lt;/div&gt;

&lt;div class=3D&quot;info-box&quot;&gt;
&lt;h4&gt;=F0=9F=93=9E Phone&lt;/h4&gt;
&lt;p&gt;+91 98765 43210&lt;/p&gt;
&lt;/div&gt;

&lt;div class=3D&quot;info-box&quot;&gt;
&lt;h4&gt;=F0=9F=93=8D Address&lt;/h4&gt;
&lt;p&gt;Varanasi, Uttar Pradesh, India&lt;/p&gt;
&lt;/div&gt;

&lt;/div&gt;



&lt;div class=3D&quot;contact-form&quot;&gt;

&lt;h2&gt;Send Message&lt;/h2&gt;

&lt;form method=3D&quot;POST&quot;&gt;
    {%csrf_token %}

&lt;input type=3D&quot;text&quot; name=3D&quot;name&quot; placeholder=3D&qu=
ot;Full Name&quot; required&gt;

&lt;input type=3D&quot;email&quot; name=3D&quot;email&quot; placeholder=3D&=
quot;Email Address&quot; required&gt;

&lt;input type=3D&quot;tel&quot; name=3D&quot;Number&quot; placeholder=3D&q=
uot;Phone Number&quot;&gt;

&lt;input type=3D&quot;text&quot; name=3D&quot;subject&quot; placeholder=3D=
&quot;Subject&quot;&gt;

&lt;textarea rows=3D&quot;6&quot; name=3D&quot;message&quot; placeholder=3D=
&quot;Write Your Message&quot;&gt;&lt;/textarea&gt;
&lt;br&gt;

 &lt;button type=3D&quot;submit&quot;&gt;Send message&lt;/button&gt;


&lt;/form&gt;
&lt;br&gt;
&lt;a href=3D&quot;{% url 'Contactdata' %}&quot;&gt;
    &lt;button type=3D&quot;submit&quot;&gt;Show data&lt;/button&gt;

&lt;/a&gt;

&lt;/div&gt;

&lt;/section&gt;

&lt;/body&gt;
&lt;/html&gt;=E2=80=AC" data-testid=3D"last-msg-status"><span dir=3D"ltr" c=
lass=3D"x1iyjqo2 x6ikm8r x10wlt62 x1n2onr6 xlyipyv xuxw1ft x1rg5ohu xnpuxes=
" style=3D"min-height: 0px;">&lt;!DOCTYPE html&gt;
&lt;html lang=3D"en"&gt;
&lt;head&gt;
&lt;meta charset=3D"UTF-8"&gt;
&lt;meta name=3D"viewport" content=3D"width=3Ddevice-width, initial-scale=
=3D1.0"&gt;
&lt;title&gt;Contact Us&lt;/title&gt;

&lt;style&gt;

*{
&nbsp;&nbsp;&nbsp;&nbsp;margin:0;
&nbsp;&nbsp;&nbsp;&nbsp;padding:0;
&nbsp;&nbsp;&nbsp;&nbsp;box-sizing:border-box;
&nbsp;&nbsp;&nbsp;&nbsp;font-family:Arial, Helvetica, sans-serif;
}

/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Hero Section
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.hero{
&nbsp;&nbsp;&nbsp;&nbsp;width:100%;
&nbsp;&nbsp;&nbsp;&nbsp;height:60vh;
&nbsp;&nbsp;&nbsp;&nbsp;background:
&nbsp;&nbsp;&nbsp;&nbsp;linear-gradient(grey,black),
&nbsp;&nbsp;&nbsp;&nbsp;url("../Image/leaf.jpg");
&nbsp;&nbsp;&nbsp;&nbsp;background-size:cover;
&nbsp;&nbsp;&nbsp;&nbsp;background-position:center;
&nbsp;&nbsp;&nbsp;&nbsp;display:flex;
&nbsp;&nbsp;&nbsp;&nbsp;justify-content:center;
&nbsp;&nbsp;&nbsp;&nbsp;align-items:center;
&nbsp;&nbsp;&nbsp;&nbsp;text-align:center;
&nbsp;&nbsp;&nbsp;&nbsp;color:white;
&nbsp;&nbsp;&nbsp;&nbsp;padding:20px;
}

.Contact{
&nbsp;&nbsp;&nbsp;&nbsp;max-width:700px;
}

.Contact h1{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:55px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:15px;
&nbsp;&nbsp;&nbsp;&nbsp;color:orange;
}

.Contact h2{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:28px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:20px;
}

.Contact p{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:18px;
&nbsp;&nbsp;&nbsp;&nbsp;line-height:30px;
&nbsp;&nbsp;&nbsp;&nbsp;color:#f2f2f2;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Contact Section
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.contact-section{
&nbsp;&nbsp;&nbsp;&nbsp;width:100%;
&nbsp;&nbsp;&nbsp;&nbsp;padding:80px 8%;
&nbsp;&nbsp;&nbsp;&nbsp;display:flex;
&nbsp;&nbsp;&nbsp;&nbsp;justify-content:space-between;
&nbsp;&nbsp;&nbsp;&nbsp;align-items:flex-start;
&nbsp;&nbsp;&nbsp;&nbsp;gap:50px;
&nbsp;&nbsp;&nbsp;&nbsp;background:#f7f8fc;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Left Side
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.contact-info{
&nbsp;&nbsp;&nbsp;&nbsp;width:40%;
}

.contact-info h2{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:40px;
&nbsp;&nbsp;&nbsp;&nbsp;color:#222;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:20px;
}

.contact-info&gt;p{
&nbsp;&nbsp;&nbsp;&nbsp;color:#666;
&nbsp;&nbsp;&nbsp;&nbsp;line-height:28px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:35px;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Info Box
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.info-box{
&nbsp;&nbsp;&nbsp;&nbsp;background:white;
&nbsp;&nbsp;&nbsp;&nbsp;padding:20px;
&nbsp;&nbsp;&nbsp;&nbsp;border-radius:15px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:20px;
&nbsp;&nbsp;&nbsp;&nbsp;box-shadow:0 5px 15px rgba(0,0,0,.08);
&nbsp;&nbsp;&nbsp;&nbsp;transition:.4s;
}

.info-box:hover{
&nbsp;&nbsp;&nbsp;&nbsp;transform:translateY(-8px);
&nbsp;&nbsp;&nbsp;&nbsp;box-shadow:0 10px 25px rgba(0,0,0,.15);
}

.info-box h4{
&nbsp;&nbsp;&nbsp;&nbsp;color:orange;
&nbsp;&nbsp;&nbsp;&nbsp;font-size:22px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:8px;
}

.info-box p{
&nbsp;&nbsp;&nbsp;&nbsp;color:#555;
&nbsp;&nbsp;&nbsp;&nbsp;font-size:17px;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Right Side
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

.contact-form{
&nbsp;&nbsp;&nbsp;&nbsp;width:60%;
&nbsp;&nbsp;&nbsp;&nbsp;background:white;
&nbsp;&nbsp;&nbsp;&nbsp;padding:40px;
&nbsp;&nbsp;&nbsp;&nbsp;border-radius:20px;
&nbsp;&nbsp;&nbsp;&nbsp;box-shadow:0 8px 25px rgba(0,0,0,.08);
&nbsp;&nbsp;&nbsp;&nbsp;transition:.4s;
}

.contact-form:hover{
&nbsp;&nbsp;&nbsp;&nbsp;transform:translateY(-5px);
}

.contact-form h2{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:35px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:30px;
&nbsp;&nbsp;&nbsp;&nbsp;color:#222;
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Form
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

form{
&nbsp;&nbsp;&nbsp;&nbsp;display:flex;
&nbsp;&nbsp;&nbsp;&nbsp;flex-direction:column;
}

input,
textarea{
&nbsp;&nbsp;&nbsp;&nbsp;width:100%;
&nbsp;&nbsp;&nbsp;&nbsp;padding:15px;
&nbsp;&nbsp;&nbsp;&nbsp;margin-bottom:20px;
&nbsp;&nbsp;&nbsp;&nbsp;border:1px solid #ccc;
&nbsp;&nbsp;&nbsp;&nbsp;border-radius:10px;
&nbsp;&nbsp;&nbsp;&nbsp;font-size:16px;
&nbsp;&nbsp;&nbsp;&nbsp;outline:none;
&nbsp;&nbsp;&nbsp;&nbsp;transition:.3s;
}

input:focus,
textarea:focus{
&nbsp;&nbsp;&nbsp;&nbsp;border-color:orange;
&nbsp;&nbsp;&nbsp;&nbsp;box-shadow:0 0 10px rgba(255,165,0,.4);
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Button
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

button{
&nbsp;&nbsp;&nbsp;&nbsp;width:220px;
&nbsp;&nbsp;&nbsp;&nbsp;padding:15px;
&nbsp;&nbsp;&nbsp;&nbsp;border:none;
&nbsp;&nbsp;&nbsp;&nbsp;border-radius:10px;
&nbsp;&nbsp;&nbsp;&nbsp;background:orange;
&nbsp;&nbsp;&nbsp;&nbsp;color:white;
&nbsp;&nbsp;&nbsp;&nbsp;font-size:17px;
&nbsp;&nbsp;&nbsp;&nbsp;cursor:pointer;
&nbsp;&nbsp;&nbsp;&nbsp;transition:.4s;
}

button:hover{
&nbsp;&nbsp;&nbsp;&nbsp;background:#222;
&nbsp;&nbsp;&nbsp;&nbsp;transform:translateY(-4px);
}


/*=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
Responsive
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D*/

@media(max-width:992px){

.contact-section{
&nbsp;&nbsp;&nbsp;&nbsp;flex-direction:column;
}

.contact-info,
.contact-form{
&nbsp;&nbsp;&nbsp;&nbsp;width:100%;
}

.Contact h1{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:42px;
}

.Contact h2{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:24px;
}

}

@media(max-width:600px){

.hero{
&nbsp;&nbsp;&nbsp;&nbsp;height:50vh;
}

.Contact h1{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:35px;
}

.Contact h2{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:20px;
}

.Contact p{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:16px;
}

.contact-info h2,
.contact-form h2{
&nbsp;&nbsp;&nbsp;&nbsp;font-size:30px;
}

button{
&nbsp;&nbsp;&nbsp;&nbsp;width:100%;
}

}

&lt;/style&gt;

&lt;/head&gt;
